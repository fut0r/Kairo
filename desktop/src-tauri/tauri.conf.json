{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KairoDB",
  "mainBinaryName": "kairo-desktop",
  "version": "1.0.0",
  "identifier": "site.arabdev.kairo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KairoDB",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Human-readable databases.",
    "longDescription": "KairoDB opens SQLite files and PostgreSQL servers, shows their tables and data, runs queries with a safety check, and applies schemas written in plain .kairo files. Local-first: no account, no telemetry.",
    "copyright": "Copyright (c) 2026 Zyad Mohamed (fut0r). Licensed under GPL-3.0.",
    "license": "GPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "homepage": "https://kairo.arabdev.site",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
